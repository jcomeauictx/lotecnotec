%!ps-nonconforming
{ARGUMENTS} stopped {[]} if {0 get} stopped {0} if cvi dup 0 gt
 {
  (Attempting to load circle and parabola scripts) =
  /ARGUMENTS [] def  % prevent the drawing scripts from running test programs
  (studded_circle.ps) run
  (parabola.ps) run
  currentpagedevice /PageSize get aload pop /height exch def /width exch def
  width 2 div height 2 div moveto currentpoint translate
  /earthradius 3159.0 def  % not accounting for refraction
  100.0 earthradius div dup scale
  (showing studded circle) =
  gsave
   1 0 0 setrgbcolor
   10 earthradius circle
   stroke
  grestore
  (showing parabola) =
  gsave
   0 earthradius rmoveto currentpoint translate
   0 0 1 setrgbcolor
   -.0002 earthradius 2 mul dup neg exch parabola
   stroke
  grestore
  showpage
 }
 {(No args given to compare.ps) =}
 ifelse
