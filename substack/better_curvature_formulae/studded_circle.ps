/showstack {count array astore aload ==} bind def
/circle { % steps r --
 2 dict begin exch /step exch def /steps 360 def
 (step: ) =only step =
 currentpoint 3 -1 roll  % x y r
 dup 10 div /marker exch def  % mark is 1/10 of radius
 dup 3 index add  % x y r x+r
 2 index moveto  % move right, to center+r
 0 step steps {
  dup step add 5 copy (stack before arc:) =only showstack arc
  dup gsave
   -90 add
   (stack before line:) =only showstack
   rotate
   0 marker rlineto stroke
  pop pop
  grestore
 } for
 pop pop pop
 end
} def

{ARGUMENTS} stopped {[]} if {0 get} stopped {0} if cvi 0 gt
 {
  currentpagedevice /PageSize get aload pop /height exch def /width exch def
  width 2 div height 2 div moveto currentpoint translate
  10 100 circle stroke
  showpage
 }
 {
  (studded-circle.ps loaded) =
 }
 ifelse
